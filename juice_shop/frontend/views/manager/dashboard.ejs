<%- include('../partials/header') %>
<%- include('../partials/navbar-manager', { active: 'dashboard' }) %>
<div class="container">
  <div class="page-header">
    <h1>📊 Manager Dashboard</h1>
    <p class="breadcrumb">Overview of your juice shop performance</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-icon">🥤</span>
      <div class="stat-label">Total Products</div>
      <div class="stat-value"><%= stats.total_products %></div>
    </div>
    <div class="stat-card green">
      <span class="stat-icon">💰</span>
      <div class="stat-label">Total Revenue</div>
      <div class="stat-value">$<%= stats.total_revenue.toFixed(2) %></div>
    </div>
    <div class="stat-card blue">
      <span class="stat-icon">📦</span>
      <div class="stat-label">Total Orders</div>
      <div class="stat-value"><%= stats.total_orders %></div>
    </div>
    <div class="stat-card orange">
      <span class="stat-icon">👥</span>
      <div class="stat-label">Customers</div>
      <div class="stat-value"><%= stats.total_customers %></div>
    </div>
    <div class="stat-card red">
      <span class="stat-icon">⚠️</span>
      <div class="stat-label">Low Stock Items</div>
      <div class="stat-value"><%= stats.low_stock_count %></div>
    </div>
    <div class="stat-card">
      <span class="stat-icon">🔔</span>
      <div class="stat-label">Active Alerts</div>
      <div class="stat-value"><%= stats.active_alerts %></div>
    </div>
    <div class="stat-card green">
      <span class="stat-icon">⭐</span>
      <div class="stat-label">Avg Rating</div>
      <div class="stat-value"><%= stats.avg_rating %> ★</div>
    </div>
    <div class="stat-card blue">
      <span class="stat-icon">💬</span>
      <div class="stat-label">Total Reviews</div>
      <div class="stat-value"><%= stats.total_reviews %></div>
    </div>
  </div>

  <div class="two-col">
    <div class="table-card">
      <div class="card-header">🏆 Top Selling Products</div>
      <% if (stats.top_products && stats.top_products.length > 0) { %>
        <table>
          <thead><tr><th>Product</th><th class="text-center">Units Sold</th><th class="text-right">Revenue</th></tr></thead>
          <tbody>
            <% stats.top_products.forEach(t => { %>
              <tr><td><strong><%= t.name %></strong></td><td class="text-center"><%= t.qty %></td><td class="text-right">$<%= (t.rev||0).toFixed(2) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state"><div class="icon">📊</div><p>No sales data yet</p></div>
      <% } %>
    </div>

    <div class="table-card">
      <div class="card-header">📋 Recent Orders</div>
      <% if (stats.recent_orders && stats.recent_orders.length > 0) { %>
        <table>
          <thead><tr><th>Order #</th><th>Customer</th><th class="text-right">Total</th><th>Status</th></tr></thead>
          <tbody>
            <% stats.recent_orders.forEach(o => { %>
              <tr>
                <td>#<%= o.id %></td>
                <td><%= o.username %></td>
                <td class="text-right">$<%= o.total.toFixed(2) %></td>
                <td><span class="badge <% if(o.status==='pending'){ %>badge-warning<% } else if(o.status==='completed'){ %>badge-success<% } else { %>badge-info<% } %>"><%= o.status %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state"><div class="icon">📦</div><p>No orders yet</p></div>
      <% } %>
    </div>
  </div>

  <div class="mt-3" style="display:flex;gap:1rem;flex-wrap:wrap">
    <a href="/manager/predictions" class="btn btn-secondary btn-lg">🔮 View Sales Predictions (RNN)</a>
    <a href="/manager/inventory" class="btn btn-primary btn-lg">📦 Manage Inventory</a>
    <a href="/manager/alerts" class="btn btn-warning btn-lg">🔔 Check Alerts</a>
  </div>
</div>
<%- include('../partials/footer') %>
