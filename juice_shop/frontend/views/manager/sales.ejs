<%- include('../partials/header') %>
<%- include('../partials/navbar-manager', { active: 'sales' }) %>
<div class="container">
  <div class="page-header">
    <h1>📈 Sales History</h1>
    <p class="breadcrumb">Last 30 days of sales performance</p>
  </div>

  <% if (history && history.length > 0) { %>
    <div class="stats-grid">
      <div class="stat-card green"><div class="stat-label">Total Units Sold</div><div class="stat-value"><%= history.reduce((s,h)=>s+h.qty,0) %></div></div>
      <div class="stat-card"><div class="stat-label">Total Revenue</div><div class="stat-value">$<%= history.reduce((s,h)=>s+h.rev,0).toFixed(2) %></div></div>
      <div class="stat-card blue"><div class="stat-label">Avg Daily Units</div><div class="stat-value"><%= Math.round(history.reduce((s,h)=>s+h.qty,0)/history.length) %></div></div>
      <div class="stat-card orange"><div class="stat-label">Best Day</div><div class="stat-value"><%= history.reduce((max,h)=>h.qty>max.qty?h:max, history[0]).qty %></div></div>
    </div>

    <div class="chart-container">
      <h3>📊 Daily Sales (Last 30 Days)</h3>
      <div class="bar-chart" id="salesChart"></div>
    </div>

    <div class="table-card">
      <div class="card-header">📋 Detailed Sales Log</div>
      <table>
        <thead><tr><th>Date</th><th>Day</th><th class="text-center">Units Sold</th><th class="text-right">Revenue</th></tr></thead>
        <tbody>
          <% history.slice().reverse().forEach(h => { %>
            <tr>
              <td><%= h.date %></td>
              <td><%= new Date(h.date).toLocaleDateString('en-US',{weekday:'long'}) %></td>
              <td class="text-center"><strong><%= h.qty %></strong></td>
              <td class="text-right">$<%= h.rev.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="mt-3">
      <a href="/manager/predictions" class="btn btn-secondary btn-lg">🔮 Run RNN Predictions on This Data</a>
    </div>
  <% } else { %>
    <div class="table-card">
      <div class="empty-state">
        <div class="icon">📈</div>
        <h3>No Sales Data Yet</h3>
        <p>Sales will appear here once customers start placing orders.</p>
        <p style="font-size:0.85rem;color:var(--gray);margin-top:0.5rem">The RNN model also generates synthetic data for training if real data is insufficient.</p>
        <a href="/manager/predictions" class="btn btn-primary mt-2">View Predictions</a>
      </div>
    </div>
  <% } %>
</div>

<script>
const data = <%= JSON.stringify(history || []) %>;
const chart = document.getElementById('salesChart');
if (chart && data.length > 0) {
  const maxVal = Math.max(...data.map(d => d.qty), 1);
  chart.innerHTML = data.map(d => {
    const h = (d.qty / maxVal) * 100;
    return `<div class="bar" style="height:${h}%" title="${d.date}: ${d.qty} units">
      <span class="bar-value">${d.qty}</span>
      <span class="bar-label">${d.date.slice(5)}</span>
    </div>`;
  }).join('');
}
</script>
<%- include('../partials/footer') %>
