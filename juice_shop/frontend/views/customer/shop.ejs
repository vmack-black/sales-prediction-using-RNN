<%- include('../partials/header') %>
<%- include('../partials/navbar-customer', { active: 'shop' }) %>
<div class="container">
  <div class="page-header">
    <h1>🥤 Fresh Juices Shop</h1>
    <p class="breadcrumb">Browse our collection of <%= products.length %> fresh juices</p>
  </div>

  <div class="category-filters" id="categoryFilters">
    <span class="category-filter active" data-cat="all">All Products</span>
    <% const cats = [...new Set(products.map(p => p.category))]; %>
    <% cats.forEach(cat => { %>
      <span class="category-filter" data-cat="<%= cat %>"><%= cat %></span>
    <% }) %>
  </div>

  <div class="product-grid" id="productGrid">
    <% products.forEach(p => { %>
      <div class="product-card" data-category="<%= p.category %>">
        <div class="product-image">🥤</div>
        <div class="product-body">
          <span class="category-tag"><%= p.category %></span>
          <h3><%= p.name %></h3>
          <p class="desc"><%= p.description %></p>
          <div class="meta">
            <span>📏 <%= p.size_ml %>ml | 🔥 <%= p.calories %> cal</span>
            <span class="rating">★ <%= p.avg_rating %> (<%= p.review_count %>)</span>
          </div>
          <div class="meta">
            <span class="price">$<%= p.price.toFixed(2) %></span>
            <% if (p.stock <= p.low_stock_threshold) { %>
              <span class="stock-badge stock-low">Only <%= p.stock %> left</span>
            <% } else { %>
              <span class="stock-badge stock-ok">In stock</span>
            <% } %>
          </div>
          <div class="product-footer">
            <a href="/customer/product/<%= p.id %>" class="btn btn-secondary btn-sm" style="flex:1">Details</a>
            <button class="btn btn-primary btn-sm" onclick="addToCart(<%= p.id %>, '<%= p.name %>', <%= p.price %>)" <% if(p.stock<=0){ %>disabled<% } %>>
              <% if(p.stock>0){ %>Add +<% } else { %>Sold out<% } %>
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Cart Floating Button -->
<div class="cart-badge" onclick="openCart()">
  🛒<span class="cart-count" id="cartCount">0</span>
</div>

<!-- Cart Modal -->
<div class="overlay" id="overlay" onclick="closeCart()"></div>
<div class="cart-modal" id="cartModal">
  <div class="cart-header">
    <span>🛒 Your Cart</span>
    <span style="cursor:pointer" onclick="closeCart()">✕</span>
  </div>
  <div class="cart-body" id="cartBody">
    <div class="empty-state"><div class="icon">🛒</div><p>Your cart is empty</p></div>
  </div>
  <div class="cart-footer">
    <div style="display:flex;justify-content:space-between;margin-bottom:0.8rem;font-size:1.1rem">
      <strong>Total:</strong> <strong id="cartTotal" style="color:var(--primary)">$0.00</strong>
    </div>
    <button class="btn btn-primary btn-block" onclick="placeOrder()">Checkout & Place Order</button>
  </div>
</div>

<script>
let cart = [];
try { cart = JSON.parse(localStorage.getItem('juice_cart') || '[]'); } catch(e) { cart = []; }

function saveCart() {
  localStorage.setItem('juice_cart', JSON.stringify(cart));
  updateCartUI();
}

function addToCart(id, name, price) {
  const existing = cart.find(i => i.product_id === id);
  if (existing) existing.quantity++;
  else cart.push({ product_id: id, name, price, quantity: 1 });
  saveCart();
  // brief feedback
  const btn = event.target;
  const orig = btn.innerHTML;
  btn.innerHTML = '✓ Added';
  setTimeout(() => btn.innerHTML = orig, 1000);
}

function updateCartUI() {
  const count = cart.reduce((s, i) => s + i.quantity, 0);
  document.getElementById('cartCount').textContent = count;
  const total = cart.reduce((s, i) => s + i.price * i.quantity, 0);
  document.getElementById('cartTotal').textContent = '$' + total.toFixed(2);
  const body = document.getElementById('cartBody');
  if (cart.length === 0) {
    body.innerHTML = '<div class="empty-state"><div class="icon">🛒</div><p>Your cart is empty</p></div>';
  } else {
    body.innerHTML = cart.map((item, idx) => `
      <div class="cart-item">
        <div>
          <div style="font-weight:600">${item.name}</div>
          <div style="font-size:0.8rem;color:var(--gray)">$${item.price.toFixed(2)} each</div>
        </div>
        <div class="qty-controls">
          <button class="qty-btn" onclick="changeQty(${idx},-1)">−</button>
          <span style="font-weight:700;min-width:24px;text-align:center">${item.quantity}</span>
          <button class="qty-btn" onclick="changeQty(${idx},1)">+</button>
          <button class="qty-btn" style="background:#fee;color:var(--danger)" onclick="removeItem(${idx})">🗑</button>
        </div>
      </div>
    `).join('');
  }
}

function changeQty(idx, delta) {
  cart[idx].quantity += delta;
  if (cart[idx].quantity <= 0) cart.splice(idx, 1);
  saveCart();
}
function removeItem(idx) { cart.splice(idx, 1); saveCart(); }

function openCart() {
  document.getElementById('cartModal').classList.add('open');
  document.getElementById('overlay').classList.add('show');
}
function closeCart() {
  document.getElementById('cartModal').classList.remove('open');
  document.getElementById('overlay').classList.remove('show');
}

async function placeOrder() {
  if (cart.length === 0) return alert('Cart is empty!');
  try {
    const items = cart.map(i => ({ product_id: i.product_id, quantity: i.quantity }));
    const resp = await fetch('/customer/order', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: JSON.stringify(items) })
    });
    const result = await resp.json();
    if (result.success) {
      alert('✅ Order placed successfully! Order #' + result.order_id + ' | Total: $' + result.total);
      cart = []; saveCart(); closeCart();
      window.location.href = '/customer/orders';
    } else {
      alert('❌ ' + (result.message || 'Order failed'));
    }
  } catch(e) { alert('Error placing order: ' + e.message); }
}

// Category filter
document.querySelectorAll('.category-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.category-filter').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const cat = btn.dataset.cat;
    document.querySelectorAll('.product-card').forEach(card => {
      card.style.display = (cat === 'all' || card.dataset.category === cat) ? '' : 'none';
    });
  });
});

updateCartUI();
</script>
<%- include('../partials/footer') %>
